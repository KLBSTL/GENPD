#version 430

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

uniform int pure_constraint_only;
uniform int write_stats;

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer {
    Edge edges[];
};

layout(std430, binding = 1) buffer GradientBuffer {
    float gradient[];
};

layout(std430, binding = 2) readonly buffer XBuffer {
    float x_pos[];
};

layout(std430, binding = 7) readonly buffer DescentBuffer {
    float d[];
};

layout(std430, binding = 8) readonly buffer YBuffer {
    float m_y[];
};

layout(std430, binding = 11) readonly buffer VertexEdgeOffsetBuffer {
    uint vertex_edge_offsets[];
};

layout(std430, binding = 12) readonly buffer VertexEdgeIndexBuffer {
    uint vertex_edge_indices[];
};

layout(std430, binding = 13) readonly buffer MassDiagBuffer {
    float mass_diag[];
};

layout(std430, binding = 10) buffer ScratchBuffer {
    float scratch[];
};

shared vec2 partial_stats[256];

vec3 load_position(uint vertex_index) {
    uint base = vertex_index * 3u;
    return vec3(x_pos[base], x_pos[base + 1u], x_pos[base + 2u]);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint vertex_index = gl_GlobalInvocationID.x;
    vec3 gradient_value = vec3(0.0);

    if (vertex_index < uint(vertex_size)) {
        uint base = vertex_index * 3u;
        vec3 xi = load_position(vertex_index);
        vec3 constraint_gradient = vec3(0.0);

        uint begin_offset = vertex_edge_offsets[vertex_index];
        uint end_offset = vertex_edge_offsets[vertex_index + 1u];
        for (uint offset = begin_offset; offset < end_offset; ++offset) {
            uint edge_index = vertex_edge_indices[offset];
            uint edge_v1 = edges[edge_index].m_v1;
            float edge_stiffness = edges[edge_index].stiffness;
            if (edges[edge_index].fixed_point == 1) {
                if (edge_v1 == vertex_index) {
                    constraint_gradient += edge_stiffness * (xi - edges[edge_index].fixed_.xyz);
                }
                continue;
            }

            uint edge_v2 = edges[edge_index].m_v2;
            uint other_vertex = (edge_v1 == vertex_index) ? edge_v2 : edge_v1;
            vec3 diff = xi - load_position(other_vertex);
            float diff_sq_norm = dot(diff, diff);
            if (diff_sq_norm > 1e-20) {
                float inv_diff_norm = inversesqrt(diff_sq_norm);
                float scale = edge_stiffness * (1.0 - edges[edge_index].rest_length * inv_diff_norm);
                constraint_gradient += scale * diff;
            }
        }

        if (pure_constraint_only != 0) {
            gradient_value = constraint_gradient;
        } else {
            vec3 y = vec3(m_y[base], m_y[base + 1u], m_y[base + 2u]);
            vec3 mass = vec3(mass_diag[base], mass_diag[base + 1u], mass_diag[base + 2u]);
            gradient_value = vec3(
                mass.x * (xi.x - y.x) + m_h * m_h * constraint_gradient.x,
                mass.y * (xi.y - y.y) + m_h * m_h * constraint_gradient.y,
                mass.z * (xi.z - y.z) + m_h * m_h * constraint_gradient.z
            );
        }

        gradient[base] = gradient_value.x;
        gradient[base + 1u] = gradient_value.y;
        gradient[base + 2u] = gradient_value.z;
    }

    if (write_stats == 0 || pure_constraint_only != 0) {
        return;
    }

    float local_norm_sq = dot(gradient_value, gradient_value);
    float local_dot = 0.0;
    if (vertex_index < uint(vertex_size)) {
        uint base = vertex_index * 3u;
        local_dot = gradient_value.x * d[base] + gradient_value.y * d[base + 1u] + gradient_value.z * d[base + 2u];
    }

    partial_stats[tid] = vec2(local_norm_sq, local_dot);
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_stats[tid] += partial_stats[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        scratch[gl_WorkGroupID.x] = partial_stats[0].x;
        scratch[gl_NumWorkGroups.x + gl_WorkGroupID.x] = partial_stats[0].y;
    }
}
