#version 430

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

layout(std430, binding = 1) readonly buffer GradientBuffer {
    float gradient[];
};

layout(std430, binding = 7) buffer DescentBuffer {
    float d[];
};

layout(std430, binding = 14) buffer StatsBuffer {
    float stats[];
};

uniform float beta_k;
uniform int update_mode;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (update_mode == 1) {
        if (idx == 0u) {
            stats[3] += 1.0;
            float new_norm_sq = stats[0];
            float gradient_dot_old_descent = stats[1];
            float old_norm_sq = stats[2];
            float beta_gpu = (old_norm_sq > 1e-20) ? (new_norm_sq / old_norm_sq) : 0.0;
            float new_gradient_dot_descent = -new_norm_sq + beta_gpu * gradient_dot_old_descent;
            bool restart = false;
            if (_pad0 == 1 && _pad1 > 0) {
                restart = (int(stats[3]) % _pad1) == 0;
            } else if (_pad0 == 2) {
                restart = isnan(new_gradient_dot_descent) || isinf(new_gradient_dot_descent) || new_gradient_dot_descent >= 0.0;
            }
            if (restart) {
                beta_gpu = 0.0;
                new_gradient_dot_descent = -new_norm_sq;
                stats[5] += 1.0;
            }
            stats[1] = new_gradient_dot_descent;
            stats[2] = new_norm_sq;
            stats[4] = beta_gpu;
        }
        return;
    }

    float beta_value = (update_mode == 2) ? stats[4] : beta_k;
    if (idx < uint(gradient_size)) {
        d[idx] = -gradient[idx] + beta_value * d[idx];
    }

    if (update_mode == 0 && idx == 0u) {
        stats[1] = -stats[0];
        stats[2] = stats[0];
        stats[3] = 0.0;
        stats[4] = beta_value;
        stats[5] = 0.0;
    }
}
