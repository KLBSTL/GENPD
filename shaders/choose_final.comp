#version 430
layout(local_size_x = 1) in;


layout(std430,binding = 5) buffer Flags {
    int valid[K];
};

layout(std430,binding = 6) buffer Result {
    int chosen_i;
};

void main() {
    for (int i = 0; i < K; ++i) {
        if (valid[i] == 1) {
            chosen_i = i;
            return;
        }
    }
    chosen_i = -1;
}
