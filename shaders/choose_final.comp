#version 430
layout(local_size_x = 1) in;


layout(std430,binding = 5) buffer Flags {
    int valid[];
};

layout(std430,binding = 6) buffer Result {
    int chosen_i;
};

void main() {

    if (gl_GlobalInvocationID.x != 0) return;

    for (int i = 0; i < 8; ++i) {
        if (valid[i] == 1) {
            chosen_i = i;
            return;
        }
    }
    chosen_i = -1;
}
