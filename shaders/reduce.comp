#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 10) readonly buffer ScratchBuffer {
    float scratch[];
};

layout(std430, binding = 15) buffer OutputBuffer {
    float out_values[];
};

uniform uint partial_count;
uniform uint output_count;
uniform uint output_offset;

shared float partial_sums[256];

void main() {
    uint output_index = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;

    if (output_index >= output_count) {
        return;
    }

    float local_sum = 0.0;
    uint base = output_index * partial_count;
    for (uint i = tid; i < partial_count; i += gl_WorkGroupSize.x) {
        local_sum += scratch[base + i];
    }

    partial_sums[tid] = local_sum;
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_sums[tid] += partial_sums[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        out_values[output_offset + output_index] = partial_sums[0];
    }
}
