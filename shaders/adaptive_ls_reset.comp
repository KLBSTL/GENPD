#version 430

layout(local_size_x = 1) in;

layout(std430, binding = 23) buffer AdaptiveLineSearchState {
    float previous_accepted_step;
    float current_batch_base;
    uint history_valid;
    uint previous_index;

    uint fallback_batches;
    uint candidate_evals;
    uint history_generation;
    uint reserved;
};

uniform uint reset_generation;

void main() {
    previous_accepted_step = 1.0;
    current_batch_base = 1.0;
    history_valid = 0u;
    previous_index = 0u;
    fallback_batches = 0u;
    candidate_evals = 0u;
    history_generation = reset_generation;
    reserved = 0u;
}
