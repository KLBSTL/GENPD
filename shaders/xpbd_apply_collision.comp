#version 430

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

struct CollisionPrimitiveGPU {
    int type;
    int _pad0;
    int _pad1;
    int _pad2;
    vec4 data0;
    vec4 data1;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer { Edge edges[]; };
layout(std430, binding = 2) buffer PositionBuffer { float x_pos[]; };
layout(std430, binding = 11) readonly buffer VertexEdgeOffsetBuffer { uint offsets[]; };
layout(std430, binding = 12) readonly buffer VertexEdgeIndexBuffer { uint edge_indices[]; };
layout(std430, binding = 16) buffer VelocityBuffer { float velocity[]; };
layout(std430, binding = 17) readonly buffer PrimitiveBuffer { CollisionPrimitiveGPU primitives[]; };
layout(std430, binding = 21) buffer DeltaBuffer { float delta[]; };

uniform uint primitive_count;
uniform float restitution_coefficient;
uniform float friction_coefficient;

void apply_contact(inout vec3 p, inout vec3 v, vec3 normal, float penetration)
{
    if (penetration <= 0.0) {
        return;
    }
    normal = normalize(normal);
    p += normal * penetration;
    float vn = dot(v, normal);
    if (vn < 0.0) {
        vec3 normal_velocity = vn * normal;
        vec3 tangent_velocity = v - normal_velocity;
        v = tangent_velocity * max(0.0, 1.0 - friction_coefficient) - restitution_coefficient * normal_velocity;
    }
}

void main()
{
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= uint(vertex_size)) {
        return;
    }

    uint delta_base = vertex_index * 4u;
    uint position_base = vertex_index * 3u;
    vec3 correction = vec3(delta[delta_base], delta[delta_base + 1u], delta[delta_base + 2u]);
    float contribution_count = delta[delta_base + 3u];
    vec3 position = vec3(x_pos[position_base], x_pos[position_base + 1u], x_pos[position_base + 2u]);
    if (contribution_count > 0.0) {
        position += correction / contribution_count;
    }

    bool pinned = false;
    vec3 pin_position = position;
    for (uint cursor = offsets[vertex_index]; cursor < offsets[vertex_index + 1u]; ++cursor) {
        Edge edge = edges[edge_indices[cursor]];
        if (edge.fixed_point == 1 && edge.m_v1 == vertex_index) {
            pinned = true;
            pin_position = edge.fixed_.xyz;
            break;
        }
    }
    if (pinned) {
        position = pin_position;
    }

    vec3 v = vec3(velocity[position_base], velocity[position_base + 1u], velocity[position_base + 2u]);
    for (uint i = 0u; i < primitive_count; ++i) {
        CollisionPrimitiveGPU primitive = primitives[i];
        if (primitive.type == 0) {
            vec3 normal = normalize(primitive.data0.xyz);
            float signed_distance = dot(position, normal) - primitive.data0.w;
            apply_contact(position, v, normal, -signed_distance);
        } else if (primitive.type == 1) {
            vec3 center = primitive.data0.xyz;
            float radius = primitive.data0.w;
            vec3 delta_to_center = position - center;
            float distance_to_center = length(delta_to_center);
            if (distance_to_center > 1.0e-8) {
                apply_contact(position, v, delta_to_center / distance_to_center, radius - distance_to_center);
            }
        }
    }

    x_pos[position_base] = position.x;
    x_pos[position_base + 1u] = position.y;
    x_pos[position_base + 2u] = position.z;
    velocity[position_base] = v.x;
    velocity[position_base + 1u] = v.y;
    velocity[position_base + 2u] = v.z;
    delta[delta_base] = 0.0;
    delta[delta_base + 1u] = 0.0;
    delta[delta_base + 2u] = 0.0;
    delta[delta_base + 3u] = 0.0;
}
