#version 430

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer {
    Edge edges[];
};

layout(std430, binding = 2) readonly buffer XBuffer {
    float x_pos[];
};

layout(std430, binding = 3) buffer EnergyBuffer {
    float energy[];
};

layout(std430, binding = 7) readonly buffer DescentBuffer {
    float d[];
};

layout(std430, binding = 8) readonly buffer YBuffer {
    float m_y[];
};

layout(std430, binding = 10) buffer ScratchBuffer {
    float scratch[];
};

layout(std430, binding = 13) readonly buffer MassDiagBuffer {
    float mass_diag[];
};

shared vec2 partial_energy[256];
shared float shared_candidate_step;

uniform int include_current_candidate;
uniform int gpu_line_search_mode;

float compute_candidate_step(uint candidate_index) {
    if (gpu_line_search_mode == 1) {
        return (candidate_index == 0u) ? 0.0 : 1.0;
    }

    if (gpu_line_search_mode == 2) {
        float t = beta;
        for (uint i = 0u; i < candidate_index; ++i) {
            t *= beta;
        }
        return t;
    }

    if (include_current_candidate != 0) {
        if (candidate_index == 0u) {
            return 0.0;
        }
        candidate_index -= 1u;
    }

    if (t0 == 0.0) {
        return 0.0;
    }

    float t = t0;
    for (uint i = 0u; i < candidate_index; ++i) {
        t *= beta;
    }
    return t;
}

vec3 load_position(uint vertex_index, float t) {
    uint base = vertex_index * 3u;
    return vec3(
        x_pos[base] + t * d[base],
        x_pos[base + 1u] + t * d[base + 1u],
        x_pos[base + 2u] + t * d[base + 2u]
    );
}

float constraint_energy(uint edge_index, float t) {
    Edge edge = edges[edge_index];
    if (edge.fixed_point == 1) {
        vec3 diff = load_position(edge.m_v1, t) - edge.fixed_.xyz;
        return 0.5 * edge.stiffness * dot(diff, diff);
    }

    vec3 diff = load_position(edge.m_v1, t) - load_position(edge.m_v2, t);
    float stretch = length(diff) - edge.rest_length;
    return 0.5 * edge.stiffness * stretch * stretch;
}

void main() {
    uint candidate_index = gl_WorkGroupID.x;
    uint partial_index = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    if (tid == 0u) {
        shared_candidate_step = compute_candidate_step(candidate_index);
    }
    barrier();
    float t = shared_candidate_step;
    float local_constraint = 0.0;
    uint start = partial_index * gl_WorkGroupSize.x + tid;
    uint stride = gl_NumWorkGroups.y * gl_WorkGroupSize.x;
    for (uint edge_index = start; edge_index < uint(edge_size); edge_index += stride) {
        local_constraint += constraint_energy(edge_index, t);
    }

    float local_inertia = 0.0;
    for (uint idx = start; idx < uint(gradient_size); idx += stride) {
        float predicted = x_pos[idx] + t * d[idx];
        float diff = predicted - m_y[idx];
        local_inertia += 0.5 * mass_diag[idx] * diff * diff;
    }

    partial_energy[tid] = vec2(local_constraint, local_inertia);
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_energy[tid] += partial_energy[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        float total = m_h * m_h * partial_energy[0].x + partial_energy[0].y;
        scratch[candidate_index * gl_NumWorkGroups.y + partial_index] = total;
    }
}

