#version 430

layout(local_size_x = 256) in;

uniform uint vertex_count;
uniform uint grid_dim0;
uniform uint grid_dim1;

layout(std430, binding = 19) readonly buffer PositionBuffer {
    float position[];
};

layout(std430, binding = 20) buffer NormalBuffer {
    float normal[];
};

vec3 load_position(uint vertex_index) {
    uint base = vertex_index * 3u;
    return vec3(position[base], position[base + 1u], position[base + 2u]);
}

void store_normal(uint vertex_index, vec3 value) {
    uint base = vertex_index * 3u;
    normal[base] = value.x;
    normal[base + 1u] = value.y;
    normal[base + 2u] = value.z;
}

uint grid_index(uint row, uint col) {
    return row * grid_dim1 + col;
}

uint clamp_uint(int value, uint upper_exclusive) {
    if (value < 0) {
        return 0u;
    }
    return min(uint(value), upper_exclusive - 1u);
}

void main() {
    uint vertex_index = gl_GlobalInvocationID.x;
    if (vertex_index >= vertex_count || grid_dim0 == 0u || grid_dim1 == 0u) {
        return;
    }

    uint row = vertex_index / grid_dim1;
    uint col = vertex_index - row * grid_dim1;
    if (row >= grid_dim0) {
        store_normal(vertex_index, vec3(0.0, 1.0, 0.0));
        return;
    }

    uint left_col = clamp_uint(int(col) - 1, grid_dim1);
    uint right_col = clamp_uint(int(col) + 1, grid_dim1);
    uint up_row = clamp_uint(int(row) - 1, grid_dim0);
    uint down_row = clamp_uint(int(row) + 1, grid_dim0);

    vec3 left_pos = load_position(grid_index(row, left_col));
    vec3 right_pos = load_position(grid_index(row, right_col));
    vec3 up_pos = load_position(grid_index(up_row, col));
    vec3 down_pos = load_position(grid_index(down_row, col));

    vec3 tangent_col = right_pos - left_pos;
    vec3 tangent_row = down_pos - up_pos;
    vec3 value = cross(tangent_col, tangent_row);
    float len_sq = dot(value, value);
    if (len_sq > 1e-20) {
        value *= inversesqrt(len_sq);
    } else {
        value = vec3(0.0, 1.0, 0.0);
    }

    store_normal(vertex_index, value);
}
