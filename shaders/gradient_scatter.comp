#version 430
#extension GL_NV_shader_atomic_float : require

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer {
    Edge edges[];
};

layout(std430, binding = 1) buffer GradientBuffer {
    float gradient[];
};

layout(std430, binding = 2) readonly buffer XBuffer {
    float x_pos[];
};

vec3 load_position(uint vertex_index) {
    uint base = vertex_index * 3u;
    return vec3(x_pos[base], x_pos[base + 1u], x_pos[base + 2u]);
}

void atomic_add_vertex(uint vertex_index, vec3 value) {
    uint base = vertex_index * 3u;
    atomicAdd(gradient[base], value.x);
    atomicAdd(gradient[base + 1u], value.y);
    atomicAdd(gradient[base + 2u], value.z);
}

void main() {
    uint edge_index = gl_GlobalInvocationID.x;
    if (edge_index >= uint(edge_size)) {
        return;
    }

    Edge edge = edges[edge_index];
    vec3 xi = load_position(edge.m_v1);
    if (edge.fixed_point == 1) {
        atomic_add_vertex(edge.m_v1, edge.stiffness * (xi - edge.fixed_.xyz));
        return;
    }

    vec3 diff = xi - load_position(edge.m_v2);
    float diff_sq_norm = dot(diff, diff);
    if (diff_sq_norm <= 1e-20) {
        return;
    }

    vec3 g = edge.stiffness * (1.0 - edge.rest_length * inversesqrt(diff_sq_norm)) * diff;
    atomic_add_vertex(edge.m_v1, g);
    atomic_add_vertex(edge.m_v2, -g);
}
