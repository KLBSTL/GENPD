#version 430

layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer {
    Edge edges[];
};

layout(std430, binding = 2) readonly buffer XBuffer {
    float x_pos[];
};

layout(std430, binding = 3) buffer EnergyBuffer {
    float energy[];
};

layout(std430, binding = 8) readonly buffer YBuffer {
    float m_y[];
};

layout(std430, binding = 13) readonly buffer MassDiagBuffer {
    float mass_diag[];
};

shared vec2 partial_sums[256];

vec3 load_position(uint vertex_index) {
    uint base = vertex_index * 3u;
    return vec3(x_pos[base], x_pos[base + 1u], x_pos[base + 2u]);
}

float constraint_energy(uint edge_index) {
    Edge edge = edges[edge_index];
    if (edge.fixed_point == 1) {
        vec3 diff = load_position(edge.m_v1) - edge.fixed_.xyz;
        return 0.5 * edge.stiffness * dot(diff, diff);
    }

    vec3 diff = load_position(edge.m_v1) - load_position(edge.m_v2);
    float stretch = length(diff) - edge.rest_length;
    return 0.5 * edge.stiffness * stretch * stretch;
}

void main() {
    uint tid = gl_LocalInvocationID.x;

    float local_constraint = 0.0;
    for (uint edge_index = tid; edge_index < uint(edge_size); edge_index += gl_WorkGroupSize.x) {
        local_constraint += constraint_energy(edge_index);
    }

    float local_inertia = 0.0;
    for (uint idx = tid; idx < uint(gradient_size); idx += gl_WorkGroupSize.x) {
        float diff = x_pos[idx] - m_y[idx];
        local_inertia += 0.5 * mass_diag[idx] * diff * diff;
    }

    partial_sums[tid] = vec2(local_constraint, local_inertia);
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            partial_sums[tid] += partial_sums[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        energy[0] = m_h * m_h * partial_sums[0].x + partial_sums[0].y;
    }
}
