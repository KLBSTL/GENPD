#version 430

// Constraint-owned XPBD Jacobi update. Each constraint writes exactly one
// correction record, so the subsequent vertex-owned gather needs no atomics.
layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform params {
    float t0;
    float beta;
    int K;
    int stiffness;
    int edge_size;
    float alpha;
    float m_h;
    int gradient_size;
    int vertex_size;
    int attachment_size;
    int _pad0;
    int _pad1;
};

struct Edge {
    uint m_v1;
    uint m_v2;
    uint m_tri1;
    uint m_tri2;
    float rest_length;
    float stiffness;
    int fixed_point;
    float _pad0;
    vec4 fixed_;
};

layout(std430, binding = 0) readonly buffer EdgeBuffer { Edge edges[]; };
layout(std430, binding = 2) readonly buffer PositionBuffer { float x_pos[]; };
layout(std430, binding = 13) readonly buffer MassDiagBuffer { float mass_diag[]; };
layout(std430, binding = 22) buffer LambdaBuffer { float lambdas[]; };
// xyz is lambda_delta * n; w is one only for a non-degenerate spring update.
layout(std430, binding = 24) buffer EdgeCorrectionBuffer { vec4 corrections[]; };

vec3 load_position(uint vertex_index)
{
    uint base = vertex_index * 3u;
    return vec3(x_pos[base], x_pos[base + 1u], x_pos[base + 2u]);
}

void main()
{
    uint edge_index = gl_GlobalInvocationID.x;
    if (edge_index >= uint(edge_size)) {
        return;
    }

    Edge edge = edges[edge_index];
    if (edge.fixed_point == 1) {
        // Pins are applied exactly in the vertex pass, as in the atomic path.
        corrections[edge_index] = vec4(0.0);
        lambdas[edge_index] = 0.0;
        return;
    }

    vec3 xi = load_position(edge.m_v1);
    vec3 xj = load_position(edge.m_v2);
    vec3 diff = xi - xj;
    float length_sq = dot(diff, diff);
    if (length_sq <= 1.0e-20) {
        // Keep the prior lambda, matching xpbd_constraints.comp, but never
        // expose a stale correction to the gather pass.
        corrections[edge_index] = vec4(0.0);
        return;
    }

    uint base_i = edge.m_v1 * 3u;
    uint base_j = edge.m_v2 * 3u;
    float wi = 1.0 / max(mass_diag[base_i], 1.0e-12);
    float wj = 1.0 / max(mass_diag[base_j], 1.0e-12);
    float compliance = 1.0 / max(edge.stiffness, 1.0e-6);
    float xpbd_alpha = compliance / max(m_h * m_h, 1.0e-12);
    float constraint_value = sqrt(length_sq) - edge.rest_length;
    float lambda_delta = (-constraint_value - xpbd_alpha * lambdas[edge_index]) / (wi + wj + xpbd_alpha);

    lambdas[edge_index] += lambda_delta;
    corrections[edge_index] = vec4(lambda_delta * diff * inversesqrt(length_sq), 1.0);
}
